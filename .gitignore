# Sprint tracking; not part of the submission.
SPRINT.md

# SDD plan scratch: ledger, briefs, reports, review packages. Lives inside
# the worktree but is never part of the branch.
.superpowers/sdd/

# Local agent worktrees and session state. An embedded git repo committed
# here becomes a gitlink with no .gitmodules, which breaks a fresh clone.
.claude/

# Sibling agent worktrees. Committing one makes a gitlink with no .gitmodules,
# which breaks a fresh clone. Same trap as .claude/.
.worktrees/

# Agent execution plans. Scaffolding for how work got done, not documentation
# of what was built; the design records live in docs/design/.
docs/superpowers/
