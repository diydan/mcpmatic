{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcpmatic",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/sessions",
      "/sessions/*",
      "/s/*/bridge",
      "/s/*/consent",
      "/s/*/account",
      "/s/*/audit",
      "/account/passkey/*",
      "/site/*",
      "/mcp",
      "/oauth/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionDO" },
      { "name": "OAUTH_CLIENT", "class_name": "OAuthClientDO" },
      { "name": "OAUTH_CODE", "class_name": "OAuthCodeDO" },
      { "name": "ACCOUNT", "class_name": "AccountDO" },
      { "name": "SITE", "class_name": "SiteDO" }
    ]
  },
  "kv_namespaces": [
    { "binding": "OAUTH_TOKENS", "id": "4c1c248d70a8467287d8e693877ab4bb" },
    { "binding": "MANIFEST_REGISTRY", "id": "4342490977ab4e8585d11a4bcda17d2f" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionDO"] },
    { "tag": "v2", "new_sqlite_classes": ["OAuthClientDO"] },
    { "tag": "v3", "new_sqlite_classes": ["OAuthCodeDO"] },
    { "tag": "v4", "new_sqlite_classes": ["AccountDO"] },
    { "tag": "v5", "new_sqlite_classes": ["SiteDO"] }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  // Third-party models through AI Gateway Unified Billing: Cloudflare holds the
  // provider credentials, so no OPENAI_API_KEY secret is needed.
  "ai": {
    "binding": "AI"
  },
  // SPEC 4.1: "application logs never record the raw path or token." The
  // capability URL in /s/<token>/... is the session's only credential, and the
  // automatic invocation log records the request URL — so leaving it on put
  // that credential in Workers Logs on every bridge, consent, account and
  // audit request. `invocation_logs: false` drops that record while keeping
  // anything the Worker logs deliberately, none of which contains a token.
  //
  // This is sprint item P1.1. Traces are left off for the same reason: a span
  // carrying the request URL would reintroduce exactly what this removes.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "limits": {
    "cpu_ms": 60000
  }
}
