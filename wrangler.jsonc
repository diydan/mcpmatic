{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcpmatic",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/sessions",
      "/sessions/*",
      "/s/*/bridge",
      "/s/*/consent",
      "/mcp",
      "/oauth/register"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionDO" },
      { "name": "OAUTH_CLIENT", "class_name": "OAuthClientDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionDO"] },
    { "tag": "v2", "new_sqlite_classes": ["OAuthClientDO"] }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  // Third-party models through AI Gateway Unified Billing: Cloudflare holds the
  // provider credentials, so no OPENAI_API_KEY secret is needed.
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "limits": {
    "cpu_ms": 60000
  }
}
